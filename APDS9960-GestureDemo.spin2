{
----------------------------------------------------------------------------------------------------
    Filename:       APDS9960-GestureDemo.spin2
    Description:    Demo of the APDS9960 driver
        * Gesture sensing functionality
    Author:         Jesse Burt
    Started:        Jun 3, 2024
    Updated:        Mar 13, 2026
    Copyright (c) 2026 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}


con

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000


obj

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000
    sensor: "sensor.light.apds9960" | SCL=16, SDA=18, I2C_FREQ=100_000


pub main() | g

    setup()

    repeat
        g := sensor.last_gesture()
        case g
            sensor.GESTURE_UP:
                ser.strln(@"UP")
            sensor.GESTURE_DOWN:
                ser.strln(@"DOWN")
            sensor.GESTURE_LEFT:
                ser.strln(@"LEFT")
            sensor.GESTURE_RIGHT:
                ser.strln(@"RIGHT")


pub setup()

    ser.start()

    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"APDS9960 driver started")
    else
        ser.strln(@"APDS9960 driver failed to start - halting")
        repeat

    sensor.preset_gesture_detect()


dat
